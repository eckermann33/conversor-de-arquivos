<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sem caixa de areia: o app roda o ffmpeg como subprocesso e lê/grava
	     nas pastas que você escolher. Nenhuma permissão de rede é pedida. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
